# URL del servidor Ollama (en Docker Compose es http://ollama:11434)
OLLAMA_URL=http://localhost:11434
# Modelo a usar (debe estar descargado: ollama pull qwen3:4b-instruct)
OLLAMA_MODEL=qwen3:4b-instruct
# Máximo de caracteres por petición
MAX_CHARS=2000
# Tiempo máximo de espera al modelo (segundos)
OLLAMA_TIMEOUT=60
# Segunda pasada del modelo que confirma que el resultado está en español (true/false)
USAR_JUEZ=true
